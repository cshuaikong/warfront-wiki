---
import { getUi } from '~/i18n/ui';
import { localizePath } from '~/lib/url';
import type { Locale } from '~/i18n/routing';
interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = getUi(locale).quickHelp;
---
<section class="quick-help rounded-lg border border-border bg-card p-5 md:p-7" data-quick-help aria-labelledby="quick-help-title">
  <h2 id="quick-help-title" class="text-2xl font-bold">{copy.title}</h2>
  <p class="mt-2 max-w-3xl leading-relaxed text-muted-foreground">{copy.description}</p>
  <form class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-end" aria-controls="quick-help-results">
    <div class="min-w-0 flex-1">
      <label for="quick-help-question" class="mb-2 block text-sm font-semibold">{copy.label}</label>
      <select id="quick-help-question" class="min-h-12 w-full rounded border border-border bg-background px-3 py-2 text-foreground" aria-describedby="quick-help-privacy">
        {copy.items.map(item => <option value={item.key}>{item.label}</option>)}
      </select>
    </div>
    <button type="submit" class="btn-primary min-h-12">{copy.button}</button>
  </form>
  <p id="quick-help-privacy" class="mt-3 text-xs text-muted-foreground">{copy.privacy}</p>
  <noscript><p class="mt-4 text-sm">{copy.nojs}</p></noscript>
  <div id="quick-help-results" class="mt-5 space-y-4" aria-live="polite" aria-atomic="true">
    {copy.items.map(item => <section class="border-l-2 border-nav bg-muted/30 p-4 md:p-5" data-help-result={item.key}>
      <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">{item.evidence}</p>
      <h3 class="mt-2 text-lg font-bold">{item.label}</h3>
      <p class="mt-2 max-w-3xl leading-relaxed">{item.text}</p>
      <div class="mt-4 flex flex-wrap gap-x-6 gap-y-3 text-sm">
        <a class="font-semibold text-nav underline underline-offset-4" href={localizePath(item.href, locale)}>{item.linkLabel}</a>
        <a class="text-muted-foreground underline underline-offset-4" href={item.source} target="_blank" rel="noopener noreferrer">{copy.sourceLabel}</a>
      </div>
    </section>)}
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-quick-help]').forEach(root => {
    const form = root.querySelector<HTMLFormElement>('form');
    const select = root.querySelector<HTMLSelectElement>('select');
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-help-result]'));
    if (!form || !select || !panels.length) return;
    const show = () => {
      const valid = panels.some(panel => panel.dataset.helpResult === select.value);
      if (!valid) return;
      panels.forEach(panel => { panel.hidden = panel.dataset.helpResult !== select.value; });
    };
    form.addEventListener('submit', event => { event.preventDefault(); show(); });
    select.addEventListener('change', show);
    show();
  });
</script>
