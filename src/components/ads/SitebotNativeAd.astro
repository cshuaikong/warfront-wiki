---
import advertising from '~/config/sitebot-advertising.json';
import { getUi } from '~/i18n/ui';
import { defaultLocale, type Locale } from '~/i18n/routing';
interface Props { slotId?:string; locale?:Locale; afterAnswer?:boolean; }
const {slotId='native-bottom',locale=defaultLocale,afterAnswer=false}=Astro.props;
const adLabel=getUi(locale).shared.adLabel;
const slots=advertising.slots as Array<{id:string;enabled:boolean;kind:string;key:string;scriptUrl:string}>;
const slot=slots.find(s=>s.enabled&&s.kind==='native'&&s.id===slotId);
const consentRequired=slots.some(s=>s.enabled)||!!(import.meta.env.PUBLIC_GA_ID||import.meta.env.PUBLIC_ADSENSE_CLIENT);
---
{slot && <aside class="not-prose my-10 min-w-0 w-full max-w-full border-t border-border pt-5" aria-label={adLabel} data-sitebot-ad={afterAnswer?'native-inline':slot.id} data-sitebot-unit={slot.id} data-sitebot-after-answer={afterAnswer?'true':undefined} data-sitebot-native-placement={afterAnswer?'after-first-section':'after-body'} data-sitebot-consent-required={consentRequired?'true':undefined}>
  <p class="mb-3 text-center text-xs uppercase tracking-wider text-muted-foreground">{adLabel}</p>
  <div id={'container-'+slot.key} data-sitebot-native-src={slot.scriptUrl} class="min-h-[320px] min-w-0 w-full max-w-full"></div>
</aside>}
<style is:global>
[data-sitebot-native-placement][data-sitebot-consent-required="true"]:not([data-sitebot-consent="accepted"]){display:none}
</style>
<script is:inline>
(()=>{for(const el of document.querySelectorAll('[data-sitebot-native-src]')){
if(el.dataset.initialized)continue;el.dataset.initialized='true';
const root=el.closest('[data-sitebot-ad]');
let eligible=false,consentGranted=false;
try{consentGranted=localStorage.getItem('aw-cookie-consent')==='accepted';}catch{}
if(root)root.dataset.sitebotConsent=consentGranted?'accepted':'pending';
// Position the unit after a complete H2 section before observing or loading it.
if(root?.dataset.sitebotAfterAnswer==='true'){
 const previous=root.previousElementSibling,content=root.closest('.prose')||(previous&&previous.classList.contains('prose')?previous:null);
 if(content){const headings=Array.from(content.children).filter(node=>/^H[12]$/.test(node.tagName)),first=headings.findIndex(node=>node.tagName==='H2'),next=first<0?null:headings[first+1];
 if(next)content.insertBefore(root,next);else content.appendChild(root);}
}
const load=()=>{if(!eligible||el.dataset.loaded||root?.dataset.sitebotConsentRequired==='true'&&!consentGranted)return;if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',load,{once:true});return;}el.dataset.loaded='true';const script=document.createElement('script');script.async=true;script.dataset.cfasync='false';script.src=el.dataset.sitebotNativeSrc;script.onerror=()=>{el.dataset.adStatus='unavailable';};document.body.appendChild(script);};
document.addEventListener('aw:consent-accepted',()=>{consentGranted=true;if(root)root.dataset.sitebotConsent='accepted';load();});
const enter=()=>{eligible=true;load();};
if('IntersectionObserver' in window){const observer=new IntersectionObserver(entries=>{if(entries.some(e=>e.isIntersecting)){observer.disconnect();enter();}},{rootMargin:'200px'});observer.observe(el);}else enter();}})();
</script>
